# --- data (never committed; see PLAN/PREREQUISITES.md for how to obtain) ---
data/
demo/data/
*.SAFE/
*.tif
*.tiff
*.nc
*.zst
*.zip

# --- model weights ---
weights/
*.pt
*.pth
*.onnx

# Committed baseline model artifacts used by the reproducible demo/training setup.
!weights/
!weights/yolo26n.pt
!yolo11n-seg.pt

# --- secrets ---
.env
.netrc

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- node ---
node_modules/
frontend/dist/
frontend/.vite/

# --- editors / os ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
._*

# --- outputs ---
runs/
outputs/
*.log

# --- eval artifacts: derived, regenerate with scripts/ ---
# Evidence worth keeping (.json/.md/.geojson/.png) stays tracked; these do not.
eval/**/feature_cache/
eval/**/*.npz
eval/**/*.jsonl
# --- frontend scratch ---
frontDemo/.tmp/

# Superseded component snapshots. Not gitignoring this is not only a
# housekeeping matter: Tailwind v4 scans it, so a removed component in here
# still emits utilities into the shipped CSS. See the reduced-motion note in
# frontDemo/src/index.css.
frontDemo/.backup/

# Backups written by scripts/repath_artifacts.py before it rewrites an
# artifact in place. Local safety net; eval/ is not otherwise ignored.
*.orig

# TypeScript incremental build state; regenerated by `tsc -b`.
frontDemo/tsconfig.tsbuildinfo

# The live demo is deployed by Vercel from this repository, so what the
# console fetches at runtime has to be committed (2026-09-25): the three real
# runs (drift.json + scene.json, ~22 MB, from export_drift_runs and
# export_real_scenes) and the browser segmenter (13 MB, ml.export.onnx_export).
# Without them every Real view is a 404 and uploads have no model. They are
# derived: regenerate them, never hand-edit them.
!frontDemo/public/runs/
!frontDemo/public/models/*.onnx
