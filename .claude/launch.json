{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontDemo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontDemo"
      ],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "frontDemo-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "frontDemo",
        "--",
        "--port",
        "5190"
      ],
      "port": 5190,
      "autoPort": true
    },
    {
      "name": "review-pack",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5195",
        "--bind",
        "127.0.0.1",
        "--directory",
        "eval/phase2-closure/annotation-pilot-cfar"
      ],
      "port": 5195
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
