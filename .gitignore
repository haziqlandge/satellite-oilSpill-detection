# --- data (never committed; see PLAN/PREREQUISITES.md for how to obtain) ---
data/
demo/data/
*.SAFE/
*.tif
*.tiff
*.nc
*.zst
*.zip

# --- model weights ---
weights/
*.pt
*.pth
*.onnx

# Committed baseline model artifacts used by the reproducible demo/training setup.
!weights/
!weights/yolo26n.pt
!yolo11n-seg.pt

# --- secrets ---
.env
.netrc

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- node ---
node_modules/
frontend/dist/
frontend/.vite/

# --- editors / os ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
._*

# --- outputs ---
runs/
outputs/
*.log

# --- eval artifacts: derived, regenerate with scripts/ ---
# Evidence worth keeping (.json/.md/.geojson/.png) stays tracked; these do not.
eval/**/feature_cache/
eval/**/*.npz
eval/**/*.jsonl
# --- frontend scratch ---
frontDemo/.tmp/

# Superseded component snapshots. Not gitignoring this is not only a
# housekeeping matter: Tailwind v4 scans it, so a removed component in here
# still emits utilities into the shipped CSS. See the reduced-motion note in
# frontDemo/src/index.css.
frontDemo/.backup/

# Backups written by scripts/repath_artifacts.py before it rewrites an
# artifact in place. Local safety net; eval/ is not otherwise ignored.
*.orig

# TypeScript incremental build state; regenerated by `tsc -b`.
frontDemo/tsconfig.tsbuildinfo

# The blanket `runs/` rule above also catches frontDemo/public/runs, where the
# exported OpenDrift artifacts live. That is deliberate but not obvious: they
# are ~10 MB of derived data and about five minutes to regenerate with
#   .venv/Scripts/python.exe -m scripts.export_drift_runs --all
# A fresh clone therefore has no real drift until that is run, and
# `npm run check:realdrift` skips rather than fails when they are absent.
