# Copy to .env and fill in. .env is git-ignored.
# Account signup details: PLAN/PREREQUISITES.md

# --- database ---
# Native Windows install (no Docker):
DATABASE_URL=postgresql+psycopg://oilspill:oilspill@localhost:5432/oilspill
# If PostGIS is unavailable, the scaffold still runs; DB-backed tests
# are skipped automatically (see tests/conftest.py).

# --- Copernicus Data Space Ecosystem (Sentinel-1 GRD) ---
# https://dataspace.copernicus.eu  -- SciHub is retired, do not use it.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Copernicus Marine Service (CMEMS ocean currents) ---
# https://marine.copernicus.eu
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# --- Climate Data Store (ERA5 wind) ---
# https://cds.climate.copernicus.eu
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- paths ---
DATA_DIR=./data
WEIGHTS_DIR=./weights

# --- runtime ---
LOG_LEVEL=INFO
# Force CPU even if a CUDA device is present (see PLAN/PREREQUISITES.md --
# the local GT 710 is compute capability 3.5 and unusable by modern PyTorch).
FORCE_CPU=1
