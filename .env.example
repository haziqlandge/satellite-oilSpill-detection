# Copy to .env and fill in. .env is git-ignored and must never be zipped or shared.
# Account signup details: PLAN/PREREQUISITES.md

# --- database: Supabase (hosted Postgres + PostGIS) ---
# Full setup: scripts/SETUP_DATABASE.md
# Project oilSpill-Detect already exists: ref hbctpozvofhxlioywcjw, ap-south-1.
# Set the database password in the dashboard first; API-created projects have none.
#
# Use the DIRECT connection (port 5432), not the transaction pooler (6543): the
# pooler has no prepared statements, which alembic and psycopg3 both need.
# URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.hbctpozvofhxlioywcjw.supabase.co:5432/postgres?sslmode=require

# Remote database, so this is a network round trip. 15 s covers a free-tier
# project waking from pause; 3 s was a local-socket value and fails spuriously.
DB_CONNECT_TIMEOUT=15

# REST endpoint + publishable key, for the PHASE-07 frontend. Not used by the
# pipeline. Never put the service_role / secret key here.
SUPABASE_URL=https://hbctpozvofhxlioywcjw.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key from dashboard>

# --- Copernicus Data Space Ecosystem (Sentinel-1 GRD) ---
# https://dataspace.copernicus.eu  -- SciHub is retired, do not use it.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Copernicus Marine Service (CMEMS ocean currents) ---
# https://marine.copernicus.eu
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# --- Climate Data Store (ERA5 wind) ---
# https://cds.climate.copernicus.eu
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- paths ---
DATA_DIR=./data
WEIGHTS_DIR=./weights

# --- runtime ---
LOG_LEVEL=INFO
# Debug override only. Leave at 0 - backend/device.py detects an unusable GPU
# (sm < 50 or < 8 GB) and falls back to CPU by itself, so this needs no change
# when switching machines.
FORCE_CPU=0
